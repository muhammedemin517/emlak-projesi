# Yerel Veritabanı ve Çalışma Zamanı Verileri (YENİ)
data/

# Bağımlılıklar (İnternetten yüklenen devasa kütüphane klasörü)
node_modules/
jspm_packages/
web_modules/

# Log Dosyaları (Hata ve çalışma günlükleri)
*.log
npm-debug.log*
yarn-debug.log*

# İşletim Sistemi Kalıntıları
.DS_Store
Thumbs.db

# Çevresel değişkenler (.env gerçek değerleri içerir, örneği commit edilir)
.env

# Kullanıcı yüklemeleri (uploads) versiyon kontrolüne dahil edilmez
public/uploads/
!public/uploads/.gitkeep

# Editör ve IDE Ayarları
.vscode/
.idea/