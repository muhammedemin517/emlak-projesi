<!DOCTYPE html>
<html lang="tr">
<head>
    <%- include('partials/head') %>
</head>
<body>
    <div class="auth-wrap">
        <div class="auth-card">
            <div class="brand-logo">Yeni Hesap Oluştur</div>
            <div class="brand-slogan">Hemen katılın, emlak pazarındaki fırsatları kaçırmayın.</div>

            <form id="registerForm">
                <div class="form-group">
                    <label for="username">Kullanıcı Adı</label>
                    <input type="text" id="username" class="form-control" placeholder="Örn: emrebalcan" required>
                </div>

                <div class="form-group">
                    <label for="role">Üyelik Tipi (Rol)</label>
                    <select id="role" class="form-control" required>
                        <option value="" disabled selected>Seçiniz...</option>
                        <option value="Bireysel Kullanıcı">Bireysel Kullanıcı (Maks 3 İlan)</option>
                        <option value="Emlak Ofisi / Danışman">Emlak Ofisi / Danışman (Sınırsız & Öne Çıkan)</option>
                    </select>
                </div>

                <div class="form-group" id="companyGroup" style="display:none;">
                    <label for="companyName">Firma / Acente İsmi</label>
                    <input type="text" id="companyName" class="form-control" placeholder="Örn: Kuzey Emlak">
                </div>

                <div class="form-group">
                    <label for="password">Şifre</label>
                    <input type="password" id="password" class="form-control" placeholder="********" required>
                </div>

                <div class="checkbox-group">
                    <input type="checkbox" id="terms" required>
                    <label for="terms">Kullanım şartlarını kabul ediyorum.</label>
                </div>

                <button type="submit" class="btn btn-green btn-block">Hesabımı Oluştur ve Başla 🚀</button>
            </form>

            <div class="switch">
                Zaten üye misiniz? <a href="/login">Giriş Yapın</a>
            </div>
        </div>
    </div>

    <script>
        // Role göre firma alanını göster/gizle
        document.getElementById('role').addEventListener('change', function () {
            const companyGroup = document.getElementById('companyGroup');
            const companyInput = document.getElementById('companyName');
            if (this.value === 'Emlak Ofisi / Danışman') {
                companyGroup.style.display = 'block';
                companyInput.required = true;
            } else {
                companyGroup.style.display = 'none';
                companyInput.required = false;
                companyInput.value = '';
            }
        });

        document.getElementById('registerForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const username = document.getElementById('username').value;
            const role = document.getElementById('role').value;
            const password = document.getElementById('password').value;
            const companyName = document.getElementById('companyName').value;

            try {
                const response = await fetch('/register', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username, role, password, companyName })
                });
                const result = await response.json();
                if (response.ok) {
                    alert(result.message || 'Kayıt başarılı!');
                    window.location.href = result.redirectUrl || '/login';
                } else {
                    alert(result.message || 'Kayıt işlemi başarısız oldu.');
                }
            } catch (err) {
                alert('Sunucuyla iletişim kurulurken bir hata oluştu.');
            }
        });
    </script>
</body>
</html>
