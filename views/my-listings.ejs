<!DOCTYPE html>
<html lang="tr">
<head>
    <%- include('partials/head') %>
</head>
<body>
    <%- include('partials/nav') %>

    <main class="container">
        <div class="flex-between">
            <h2>📌 İlanlarım (<%= listings.length %>)</h2>
            <a href="/dashboard" class="btn btn-green btn-sm">➕ Yeni İlan / Değer Hesapla</a>
        </div>

        <div class="card mt-2">
            <div class="table-wrap">
                <table class="tbl">
                    <thead>
                        <tr>
                            <th>Şehir / İlçe</th>
                            <th>m²</th>
                            <th>Fiyat</th>
                            <th>Açıklama</th>
                            <th style="text-align:center;">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (listings.length === 0) { %>
                            <tr><td colspan="5" class="text-center text-muted" style="padding:28px;">
                                Henüz eklediğiniz bir ilan yok.
                            </td></tr>
                        <% } %>
                        <% listings.forEach(function(item){ %>
                            <tr>
                                <td><b><%= item.district %></b> / <%= item.subDistrict %></td>
                                <td><%= item.sqm %></td>
                                <td style="color:var(--green); font-weight:700;"><%= helpers.formatCurrency(item.userPrice) %></td>
                                <td class="text-muted" style="max-width:220px;"><%= item.note %></td>
                                <td style="text-align:center; white-space:nowrap;">
                                    <a href="/listings/<%= item.id %>" class="btn btn-outline btn-sm">Gör</a>
                                    <a href="/edit-listing/<%= item.id %>" class="btn btn-primary btn-sm">Düzenle</a>
                                    <form action="/delete-listing" method="POST" style="display:inline;">
                                        <input type="hidden" name="id" value="<%= item.id %>">
                                        <button type="submit" class="btn btn-danger btn-sm"
                                                onclick="return confirm('Bu ilanı silmek istediğinize emin misiniz?')">Sil</button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</body>
</html>
