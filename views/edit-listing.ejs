<!DOCTYPE html>
<html lang="tr">
<head>
    <%- include('partials/head') %>
</head>
<body>
    <%- include('partials/nav') %>

    <main class="container narrow">
        <div class="card">
            <h2>✏️ İlanı Düzenle</h2>
            <p class="text-muted"><%= listing.district %> / <%= listing.subDistrict %> · <%= listing.sqm %> m² · <%= listing.roomCount %></p>

            <form action="/edit-listing/<%= listing.id %>" method="POST" enctype="multipart/form-data" class="mt-2">
                <div class="form-group">
                    <label>Mevcut Fotoğraflar</label>
                    <% if (photos && photos.length) { %>
                        <div style="display:flex; gap:8px; flex-wrap:wrap;">
                            <% photos.forEach(function(p){ %>
                                <img src="<%= p %>" alt="foto" style="width:90px; height:70px; object-fit:cover; border-radius:6px; border:1px solid var(--border);">
                            <% }); %>
                        </div>
                    <% } else if (listing.photo) { %>
                        <img src="<%= listing.photo %>" alt="mevcut" style="width:100%; max-height:200px; object-fit:cover; border-radius:8px;">
                    <% } else { %>
                        <p class="text-muted" style="font-size:13px;">Bu ilanda henüz fotoğraf yok.</p>
                    <% } %>
                </div>

                <div class="form-group">
                    <label for="photos">Yeni Fotoğraf Ekle (opsiyonel, çoklu)</label>
                    <input type="file" name="photos" id="photos" accept="image/*" multiple>
                    <div class="form-hint">Yeni fotoğraflar mevcut olanlara eklenir (en fazla 8).</div>
                </div>

                <div class="form-group">
                    <label for="customPrice">İlan Fiyatı (TL)</label>
                    <input type="number" name="customPrice" id="customPrice" value="<%= listing.userPrice %>" required>
                </div>

                <div class="form-group">
                    <label for="note">Açıklama</label>
                    <textarea name="note" id="note"><%= listing.note %></textarea>
                </div>

                <button type="submit" class="btn btn-green btn-block">💾 Değişiklikleri Kaydet</button>
            </form>

            <a href="/my-listings" class="btn btn-outline btn-block mt-2">⬅ İptal</a>
        </div>
    </main>
</body>
</html>
